# Copy to .env. Never commit real secrets.
ENV=dev
LOG_LEVEL=INFO
FEATURE_EMPLOYEE_INVITATIONS=false
FEATURE_EMPLOYEE_PROFILES=false
FEATURE_EMPLOYEE_TRANSFERS=false
FEATURE_ANALYTICS=false
FEATURE_DEPARTMENT_PROFILES=false
FEATURE_TEAMS=false
FEATURE_EMPLOYEE_IMPORT=false

# hrms_api: member of hrms_app, RLS enforced (every tenant request)
DATABASE_URL=postgresql+asyncpg://hrms_api:hrms_api_dev@localhost:5432/hrms
# hrms_admin: hrms_platform, BYPASSRLS (signup, platform admin, cross-tenant jobs)
PLATFORM_DATABASE_URL=postgresql+asyncpg://hrms_admin:hrms_admin_dev@localhost:5432/hrms
# table owner: Alembic only
MIGRATION_DATABASE_URL=postgresql+psycopg://hrms_owner:hrms_owner_dev@localhost:5432/hrms

REDIS_URL=redis://localhost:6379/0

# at least 32 chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-change-me-change-me-change-me

# tenants live at <slug>.<BASE_DOMAIN>; *.localhost resolves to 127.0.0.1 in browsers
BASE_DOMAIN=localhost
CORS_ORIGINS=["http://localhost:3000"]

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hrms
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
# Optional staged employee workflows (disabled by default).
FEATURE_EMPLOYEE_PROFILES=false
FEATURE_EMPLOYEE_TRANSFERS=false
